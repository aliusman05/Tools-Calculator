NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loads only after analytics consent, and never on previews.
NEXT_PUBLIC_GA_ID=
# Contact form (see docs/LAUNCH-TODO.md)
CONTACT_WEBHOOK_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Advertising (see docs/ADS.md). Ads stay off unless ADS_ENABLED is "true" AND a valid client ID is set,
# and never run on dev servers or preview deployments.
NEXT_PUBLIC_ADS_ENABLED=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_END=
# Optional: show labelled empty ad boxes, and request AdSense test ads.
NEXT_PUBLIC_ADS_PLACEHOLDER=
NEXT_PUBLIC_ADS_TEST_MODE=
